# Browser → API base (public; used client-side and for tap-to-call fallbacks)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# SSR → API base (server-side/container-internal; docker sets http://backend:8000/...)
NUXT_API_BASE_INTERNAL=http://localhost:8000/api/v1

# --- Matomo (analytics). Leave blank in dev to disable the tracker. ---
NUXT_PUBLIC_MATOMO_URL=https://analytics.didargold.com
NUXT_PUBLIC_MATOMO_SITE_ID=1
# Goal / custom-dimension IDs created in the Matomo UI (see README).
NUXT_PUBLIC_MATOMO_GOAL_ORDER=1
NUXT_PUBLIC_MATOMO_GOAL_PHONE=2
NUXT_PUBLIC_MATOMO_DIM_PROVINCE=1
NUXT_PUBLIC_MATOMO_DIM_SOURCE=2
