{
  "platform": "docker",
  "app": "didar-gold-api",
  "port": 8000,
  "healthCheck": {
    "command": "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health').status==200 else 1)\"",
    "interval": 30,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 20
  }
}
