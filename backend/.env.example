# --- Database ---
# asyncpg driver. In docker-compose this points at the `db` service.
DATABASE_URL=postgresql+asyncpg://didar:didar@localhost:5432/didar

# --- Redis (optional) ---
# Blank = in-process caches + per-worker rate limits (fine on a single node).
# Set to share cache + rate limits across workers/instances (Liara Redis in
# prod). The app fails open (keeps serving from DB) if Redis is down.
REDIS_URL=

# --- Admin auth (single account, no user table) ---
ADMIN_USERNAME=admin
# argon2 hash — generate with: python -m app.core.security "your-password"
ADMIN_PASSWORD_HASH=
# signs the session cookie — set a long random value in production
SECRET_KEY=change-me-in-prod
SESSION_MAX_AGE=604800
# True only over HTTPS (prod). Keep False for local http.
COOKIE_SECURE=false

# --- CORS: the Nuxt origin(s), comma-separated ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Media storage (local dev). Swap for S3 in prod, see services/storage.py ---
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media

# --- MinIO source for the product-photo import (python -m app.import_images) ---
# Each product's photos live in a bucket folder named after its SKU (e.g. 2000/).
# Used ONLY by the import job, not at request time. Leave blank to disable.
MINIO_ENDPOINT=          # host:port, e.g. minio.example.com:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=true        # false for a plain-http MinIO

# --- SMS notification (PRIMARY channel) ---
# Provider: kavenegar (default HTTP) or `log` (prints instead of sending).
# Leave SMS_API_KEY empty in dev and orders are logged, not sent.
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
SMS_ADMIN_PHONE=          # where new-order alerts are sent
ADMIN_ORDER_BASE_URL=http://localhost:3000/admin/orders

# --- Telegram / Email adapters (stubs, unused unless you switch primary) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
