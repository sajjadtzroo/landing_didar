{
  "uid": "didar-overview",
  "title": "Didar — Service Overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (status) (rate(http_requests_total[5m]))",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Log volume by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum by (service) (count_over_time({project=\"landing_didar\"}[5m]))",
        "legendFormat": "{{service}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Errors (level=ERROR+) by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "sum by (service) (count_over_time({project=\"landing_didar\", level=~\"ERROR|CRITICAL\"}[5m]))",
        "legendFormat": "{{service}}"
      }]
    },
    {
      "id": 5, "type": "logs", "title": "Latest errors",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "uid": "loki" },
      "options": { "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{project=\"landing_didar\", level=~\"ERROR|CRITICAL\"}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Rate-limit trips & slow queries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(ratelimit_trips_total[5m]))", "legendFormat": "ratelimit trips/s" },
        { "expr": "rate(db_slow_queries_total[5m])", "legendFormat": "slow queries/s" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Container memory (app stack)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{
        "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_project=\"landing_didar\"}",
        "legendFormat": "{{container_label_com_docker_compose_service}}"
      }]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
